# Copy to .env and fill in.  .env is gitignored and MUST NEVER be committed.
#
# This is the single private file. Nothing in the repository names your account, your profile,
# your bucket or your site's IAM requirements - it all comes from here.
#   cp .env.example .env && $EDITOR .env

# --- your AWS access -------------------------------------------------------------------------
# The profile your login produces. "mosaic-gen" in the docs is a placeholder.
AWS_PROFILE=mosaic-gen
# Pinned by spec 08 section 3 - source data and Step Functions must share a region.
AWS_REGION=us-west-2

# --- deployment identity ---------------------------------------------------------------------
# One deployment serves many runs. A new experiment is a new manifest, never a new deployment.
STRATUM_DEPLOYMENT=dev

# --- site requirements (playbook section 5) ---------------------------------------------------
# Leave EMPTY if your site imposes none. They must be present but may be blank.
STRATUM_PERMISSIONS_BOUNDARY_ARN=
STRATUM_ROLE_NAME_PREFIX=

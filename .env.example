# Copy to .env and fill in.  .env is gitignored and MUST NEVER be committed.
#
# This is the single private file. Nothing in the repository names your account, your profile,
# your bucket or your site's IAM requirements - it all comes from here.
#   cp .env.example .env && $EDITOR .env

# --- your AWS access -------------------------------------------------------------------------
# The profile your login produces. "mosaic-gen" in the docs is a placeholder.
AWS_PROFILE=mosaic-gen
# Pinned by spec 08 section 3 - source data and Step Functions must share a region.
AWS_REGION=us-west-2

# --- deployment identity ---------------------------------------------------------------------
# One deployment serves many runs. A new experiment is a new manifest, never a new deployment.
STRATUM_DEPLOYMENT=dev

# --- site requirements (playbook section 5) ---------------------------------------------------
# Leave EMPTY if your site imposes none. They must be present but may be blank.
STRATUM_PERMISSIONS_BOUNDARY_ARN=
STRATUM_ROLE_NAME_PREFIX=

# --- the deployment root (playbook sections 8-9) -----------------------------------------------
# What `make image` printed. A full digest, not a tag: the deployment pins bytes, and a tag is
# only a name for them (ADR-0003). Absent until the first image is built.
STRATUM_IMAGE_DIGEST=

# Where the monthly budget alert goes. Empty creates the budget with no subscriber, which is
# nearly useless - a runaway fan-out is otherwise discovered by the bill.
STRATUM_BUDGET_ALERT_EMAIL=

# --- the deployment's network -------------------------------------------------------------------
# One VPC for everything of ours that needs a network. Today that is the preview viewer task; the
# data plane (spec 08) will be the next. Empty means no such workload is created.
#
# NOT the Lambda worker: it is deliberately not VPC-attached, because it downloads granules from
# the DAAC over the public internet. See the note in terraform/lambda.tf.
STRATUM_VPC_ID=

# --- the preview viewer task (optional; guide/viewing.html) -------------------------------------
# An on-demand Fargate task running `stratum preview` against the storage root, reachable on its
# private IP inside the VPC. No bucket policy, no public access, nothing left running between
# looks. It needs STRATUM_VPC_ID above and an image digest; it has no network settings of its own.
#
# Terraform runs it in the VPC's subnets, behind a security group it creates: the viewer's port in,
# HTTPS and DNS out, and nothing else. No public IP is ever assigned.
#
# Optional second pin. Empty means the viewer runs the same image as the worker, which is what you
# want most of the time. Set it to a digest of its own when the worker is pinned for a campaign and
# you still want to rebuild the viewer - `make image` prints one digest, and this decides whether
# it moves the worker, the viewer, or both.
STRATUM_VIEWER_IMAGE_DIGEST=

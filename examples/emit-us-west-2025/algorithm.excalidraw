    {
      "id": "tv20126",
      "type": "text",
      "x": 1338,
      "y": 2654.7734375,
      "width": 1000.8,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1504988818,
      "version": 1,
      "versionNonce": 669638767,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Weekly, not monthly, and the reason is EMIT's clustered revisit: under a monthly epoch two looks in one month collapse to one vote and the\nloser is DISCARDED. Measured on the pilot tile, halving the epoch recovered +19.8 % of classified area in group 1 and +25.8 % in group 2 at\nthe same min_count.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Weekly, not monthly, and the reason is EMIT's clustered revisit: under a monthly epoch two looks in one month collapse to one vote and the\nloser is DISCARDED. Measured on the pilot tile, halving the epoch recovered +19.8 % of classified area in group 1 and +25.8 % in group 2 at\nthe same min_count.",
      "autoResize": true,
      "lineHeight": 1.25
    },

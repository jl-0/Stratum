    },
    {
      "id": "FZmqpbP1_z4NlAJIjoq0t",
      "type": "text",
      "x": 2599.31201171875,
      "y": 1448.975,
      "width": 181.8291015625,
      "height": 48.3,
      "angle": 0,
      "strokeColor": "#212529",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "gv20120"
      ],

__pycache__/
*.py[cod]
.venv/
.pixi/
*.egg-info/
.pytest_cache/
.ruff_cache/
.DS_Store
.env
*.tif
*.tiff
*.nc
*.parquet
!refs/**/*.parquet
trial-data/

# ---- run outputs ----
# Every example writes its storage root and its built index beside its manifest. Kept here as
# well as in each example's own .gitignore, so a NEW example is covered before anyone runs it -
# examples/emit-critical-minerals/ had no .gitignore of its own and would have committed its
# products the first time it ran.
examples/*/out/
examples/*/index/
examples/*/assets/

# ---- Terraform / AWS (docs/guide/deploying.html, "What must never be committed") ----
# NOTHING in this block may ever be committed. Terraform state holds every value Terraform
# touches, in plaintext.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
backend.hcl
!backend.hcl.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# .terraform.lock.hcl IS committed - it is the provider lock, the peer of pixi.lock.

# ---- credential material, any kind ----
.netrc
.aws/
credentials
*.pem
*.p12
*.pfx
*.key

# Dropped-in plugin wheels are built artifacts, not source (see plugins/wheels/README.md).
plugins/wheels/*.whl

# Generated by scripts/cloud-manifest.sh - names the account, never committed.
*.cloud.yaml
